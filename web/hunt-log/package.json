{
  "name": "openclaw-hunt-log",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "postbuild": "tsc --target es2022 --module esnext --moduleResolution bundler --outDir build --skipLibCheck --rootDir src src/server.ts src/ws-upgrade.ts",
    "preview": "vite preview",
